{
  "name": "super-handai-z-agent",
  "version": "1.0.0",
  "description": "Local deterministic TZ-executor agent with live terminal",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "super-handai-z": "dist/main.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
